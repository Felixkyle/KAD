<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KADIS ICT Training — Practical Installation, Engineering & Technical Skills | Abuja</title>
    <meta name="description"
        content="KADIS ICT Training delivers hands-on, practical training in CCTV & security systems, automation, solar & power, networking, satellite/entertainment and vehicle tracking — for individuals, groups and organisations.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link
        href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
        rel="stylesheet">
    <style>
        :root {
            --bg: #0B0C0F;
            --bg-2: #131519;
            --bg-3: #1A1D22;
            --bg-4: #20232A;
            --ink: #EDEEEC;
            --ink-dim: #9A9FA8;
            --ink-dimmer: #5C616A;
            --line: rgba(255, 255, 255, 0.07);
            --line-bright: rgba(255, 255, 255, 0.13);
            --amber: #D9772E;
            --amber-deep: #B85F22;
            --amber-soft: #E8A15E;
            --moss: #A9B84C;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: var(--bg);
            color: var(--ink);
            font-family: 'Manrope', sans-serif;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        h1,
        h2,
        h3,
        h4 {
            font-family: 'Sora', sans-serif;
            letter-spacing: -0.02em;
        }

        .mono {
            font-family: 'Space Mono', monospace;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        img {
            max-width: 100%;
            display: block;
        }

        button {
            font-family: inherit;
        }

        ::selection {
            background: var(--amber-soft);
            color: #111;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image: radial-gradient(circle at 15% 8%, rgba(217, 119, 46, 0.08), transparent 40%),
                radial-gradient(circle at 85% 25%, rgba(169, 184, 76, 0.045), transparent 35%),
                radial-gradient(circle at 50% 90%, rgba(217, 119, 46, 0.05), transparent 45%);
            pointer-events: none;
            z-index: 0;
        }

        .wrap {
            max-width: 1240px;
            margin: 0 auto;
            padding: 0 32px;
            position: relative;
            z-index: 2;
        }

        .reveal {
            opacity: 0;
            transform: translateY(22px);
            transition: opacity .8s cubic-bezier(.16, .8, .24, 1), transform .8s cubic-bezier(.16, .8, .24, 1);
        }

        .reveal.in-view {
            opacity: 1;
            transform: translateY(0);
        }

        @media (prefers-reduced-motion: reduce) {
            .reveal {
                opacity: 1 !important;
                transform: none !important;
                transition: none !important;
            }

            * {
                animation-duration: .01ms !important;
                scroll-behavior: auto !important;
            }
        }

        /* topbar / nav */
        .topbar {
            background: var(--bg-2);
            border-bottom: 1px solid var(--line);
            font-size: 12.5px;
            color: var(--ink-dim);
        }

        .topbar .wrap {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 38px;
            flex-wrap: wrap;
        }

        .topbar .dot {
            color: var(--amber-soft);
            margin-right: 6px;
        }

        .topbar-right {
            display: flex;
            gap: 22px;
            align-items: center;
        }

        .topbar-right a {
            color: #F4F6F4;
            font-weight: 700;
            transition: color .2s;
        }

        nav {
            position: sticky;
            top: 0;
            z-index: 50;
            background: rgba(11, 12, 15, 0.86);
            backdrop-filter: blur(16px) saturate(140%);
            border-bottom: 1px solid var(--line);
        }

        .nav-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 78px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-mark {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            background: linear-gradient(135deg, var(--amber), var(--amber-deep));
            display: flex;
            align-items: center;
            justify-content: center;
            color: #0A0B0E;
            font-weight: 800;
            font-size: 15px;
            box-shadow: 0 6px 20px rgba(217, 119, 46, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.18);
            flex-shrink: 0;
        }

        .logo .lockup {
            display: flex;
            flex-direction: column;
            line-height: 1.1;
            font-family: 'Sora';
            font-weight: 800;
            font-size: 20px;
        }

        .logo .lockup small {
            font-family: 'Space Mono';
            font-size: 10px;
            font-weight: 500;
            color: var(--ink-dim);
            letter-spacing: 0.06em;
            margin-top: 2px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 24px;
            flex: 1;
            min-width: 0;
            white-space: nowrap;
            font-size: 13.5px;
            font-weight: 600;
            color: var(--ink-dim);
            margin-left: 20px;
        }

        .nav-links a {
            position: relative;
            display: inline-flex;
            align-items: center;
            padding: 8px 0;
            white-space: nowrap;
            transition: color .2s;
        }

        .nav-links a:hover {
            color: var(--ink);
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 0;
            height: 2px;
            background: var(--amber);
            transition: width .3s cubic-bezier(.16, .8, .24, 1);
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .icon-btn {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            border: 1px solid var(--line-bright);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--ink-dim);
            transition: all .2s;
            cursor: pointer;
        }

        .icon-btn:hover {
            border-color: var(--amber);
            color: var(--amber-soft);
        }

        .btn-primary {
            background: var(--amber);
            color: #0B0C0F;
            font-weight: 700;
            font-size: 13.5px;
            padding: 11px 20px;
            border-radius: 10px;
            box-shadow: 0 8px 22px rgba(217, 119, 46, 0.22);
            transition: transform .25s cubic-bezier(.16, .8, .24, 1), box-shadow .25s, background .25s;
            white-space: nowrap;
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            background: var(--amber-soft);
            box-shadow: 0 14px 30px rgba(217, 119, 46, 0.3);
        }

        .btn-ghost {
            border: 1px solid var(--line-bright);
            color: var(--ink);
            font-weight: 700;
            font-size: 14px;
            padding: 13px 24px;
            border-radius: 10px;
            transition: all .25s cubic-bezier(.16, .8, .24, 1);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-ghost:hover {
            border-color: var(--amber);
            background: rgba(217, 119, 46, 0.06);
            transform: translateY(-2px);
        }

        .btn-text {
            font-size: 13.5px;
            font-weight: 700;
            color: var(--ink-dim);
            transition: color .2s;
        }

        .btn-text:hover {
            color: var(--amber-soft);
        }

        /* hero */
        .hero {
            padding: 72px 0 80px;
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
            gap: 56px;
            align-items: center;
        }

        .hero>div:first-child>* {
            opacity: 0;
            transform: translateY(16px);
            animation: heroIn .7s cubic-bezier(.16, .8, .24, 1) forwards;
        }

        .hero>div:first-child>*:nth-child(1) {
            animation-delay: .05s;
        }

        .hero>div:first-child>*:nth-child(2) {
            animation-delay: .15s;
        }

        .hero>div:first-child>*:nth-child(3) {
            animation-delay: .25s;
        }

        .hero>div:first-child>*:nth-child(4) {
            animation-delay: .35s;
        }

        @keyframes heroIn {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: 'Space Mono';
            font-size: 12px;
            letter-spacing: 0.08em;
            color: var(--amber-soft);
            background: rgba(217, 119, 46, 0.08);
            border: 1px solid rgba(217, 119, 46, 0.25);
            padding: 7px 14px;
            border-radius: 100px;
            margin-bottom: 24px;
        }

        .eyebrow::before {
            content: '●';
            color: var(--moss);
            font-size: 8px;
        }

        .hero h1 {
            font-size: 48px;
            line-height: 1.18;
            font-weight: 800;
            margin-bottom: 26px;
            max-width: 16ch;
        }

        .hero h1 .grad {
            background: linear-gradient(100deg, var(--amber) 10%, var(--amber-soft) 90%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .hero p {
            font-size: 16.5px;
            color: var(--ink-dim);
            max-width: 480px;
            line-height: 1.75;
            margin-bottom: 36px;
        }

        .hero-cta {
            display: flex;
            gap: 16px;
            margin-bottom: 48px;
            flex-wrap: wrap;
        }

        .hero-stats {
            display: flex;
            gap: 36px;
            flex-wrap: wrap;
        }

        .hero-stats div {
            border-left: 2px solid var(--amber);
            padding-left: 16px;
        }

        .hero-stats b {
            display: block;
            font-family: 'Sora';
            font-size: 22px;
            font-weight: 800;
            margin-bottom: 4px;
        }

        .hero-stats span {
            font-size: 12px;
            color: var(--ink-dim);
            line-height: 1.4;
        }

        .hero-visual {
            position: relative;
            height: auto;
            border-radius: 24px;
            background: linear-gradient(160deg, var(--bg-3), var(--bg-2));
            border: 1px solid var(--line);
            overflow: hidden;
            padding: 32px;
            display: flex;
            flex-direction: column;
            gap: 22px;
        }

        .flow-chip {
            display: flex;
            align-items: center;
            gap: 14px;
            background: var(--bg-4);
            border: 1px solid var(--line-bright);
            border-radius: 12px;
            padding: 14px 18px;
            font-size: 13px;
            font-weight: 700;
            line-height: 1.4;
        }

        .flow-chip .num {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--amber);
            color: #0B0C0F;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            flex-shrink: 0;
        }

        .flow-arrow {
            text-align: center;
            color: var(--ink-dimmer);
            font-size: 13px;
            padding: 0;
            margin: 4px 0;
        }

        @media (max-width:980px) {
            .hero {
                grid-template-columns: 1fr;
            }

            .hero-visual {
                height: auto;
            }

            .hero h1 {
                font-size: 34px;
            }
        }

        .trust {
            border-top: 1px solid var(--line);
            border-bottom: 1px solid var(--line);
            padding: 30px 0;
            background: var(--bg-2);
        }

        .trust .wrap {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 22px;
        }

        .trust-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            color: var(--ink-dim);
            font-weight: 600;
            line-height: 1.5;
        }

        .trust-item .ic {
            color: var(--amber-soft);
            font-size: 15px;
        }

        section {
            padding: 108px 0;
        }

        section+section {
            padding-top: 0;
        }

        .sec-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 52px;
            gap: 28px;
            flex-wrap: wrap;
        }

        .sec-head h2 {
            font-size: 30px;
            font-weight: 800;
            line-height: 1.3;
            margin-top: 6px;
        }

        .sec-head p {
            color: var(--ink-dim);
            font-size: 14.5px;
            line-height: 1.65;
            max-width: 420px;
        }

        .sec-eyebrow {
            font-family: 'Space Mono';
            font-size: 12px;
            color: var(--amber-soft);
            letter-spacing: .08em;
            margin-bottom: 12px;
            display: block;
        }

        /* why-train feature grid */
        .feat-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 20px;
        }

        .feat-card {
            background: var(--bg-2);
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 28px 22px;
            transition: border-color .3s, transform .3s;
        }

        .feat-card:hover {
            border-color: rgba(217, 119, 46, 0.3);
            transform: translateY(-4px);
        }

        .feat-card .ic {
            font-size: 24px;
            margin-bottom: 18px;
        }

        .feat-card h5 {
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 10px;
            line-height: 1.4;
        }

        .feat-card p {
            font-size: 12.5px;
            color: var(--ink-dim);
            line-height: 1.65;
        }

        @media (max-width:980px) {
            .feat-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        /* category block */
        .cat-block {
            border: 1px solid var(--line);
            border-radius: 20px;
            background: linear-gradient(160deg, var(--bg-3), var(--bg-2));
            margin-bottom: 28px;
            overflow: hidden;
        }

        .cat-block-head {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 30px 36px;
            border-bottom: 1px solid var(--line);
            flex-wrap: wrap;
        }

        .cat-block-head .num {
            font-family: 'Space Mono';
            font-size: 12px;
            color: var(--amber-soft);
        }

        .cat-block-head h3 {
            font-size: 21px;
            font-weight: 800;
            line-height: 1.3;
        }

        .cat-block-body {
            padding: 32px 36px 36px;
            display: grid;
            gap: 24px;
        }

        .course-card {
            background: var(--bg-2);
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 24px 26px;
        }

        .course-card h4 {
            font-size: 15.5px;
            font-weight: 700;
            margin-bottom: 10px;
            line-height: 1.4;
        }

        .course-card p {
            font-size: 13px;
            color: var(--ink-dim);
            line-height: 1.65;
            margin-bottom: 18px;
        }

        .topic-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
        }

        .topic-tags span {
            font-size: 11px;
            font-weight: 600;
            padding: 6px 13px;
            border-radius: 20px;
            background: var(--bg-3);
            border: 1px solid var(--line-bright);
            color: var(--ink-dim);
            line-height: 1.4;
        }

        .safety-note {
            font-size: 12.5px;
            color: var(--amber-soft);
            background: rgba(217, 119, 46, 0.08);
            border: 1px solid rgba(217, 119, 46, 0.22);
            border-radius: 10px;
            padding: 16px 20px;
            line-height: 1.7;
        }

        /* quick category nav pills */
        .qc-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 18px;
        }

        .qc-card {
            background: var(--bg-2);
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 24px 18px;
            text-align: center;
            transition: border-color .3s, transform .3s;
        }

        .qc-card:hover {
            border-color: rgba(217, 119, 46, 0.3);
            transform: translateY(-3px);
        }

        .qc-card .ic {
            font-size: 24px;
            margin-bottom: 12px;
        }

        .qc-card h5 {
            font-size: 12.5px;
            font-weight: 700;
            margin-bottom: 10px;
            letter-spacing: .03em;
        }

        .qc-card span {
            font-size: 10.5px;
            color: var(--ink-dim);
            line-height: 1.65;
            display: block;
        }

        @media (max-width:980px) {
            .qc-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        /* checklist */
        .check-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 18px 32px;
            margin-top: 8px;
        }

        .check-item {
            display: flex;
            gap: 14px;
            align-items: flex-start;
            font-size: 14px;
            color: var(--ink-dim);
            line-height: 1.6;
            padding: 4px 0;
        }

        .check-item .tick {
            color: var(--moss);
            font-weight: 800;
            flex-shrink: 0;
        }

        @media (max-width:700px) {
            .check-grid {
                grid-template-columns: 1fr;
            }
        }

        /* who can enrol tag cloud */
        .about-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 8px;
        }

        .about-tags span {
            background: var(--bg-2);
            border: 1px solid var(--line-bright);
            border-radius: 100px;
            padding: 11px 20px;
            font-size: 13px;
            font-weight: 600;
            color: var(--ink);
            transition: border-color .2s, transform .2s;
            line-height: 1.4;
        }

        .about-tags span:hover {
            border-color: var(--amber);
            transform: translateY(-2px);
        }

        /* process flow chain */
        .flow-chain {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 14px;
            margin-top: 8px;
        }

        .flow-chain .node {
            background: var(--bg-2);
            border: 1px solid var(--line-bright);
            border-radius: 10px;
            padding: 14px 22px;
            font-size: 13px;
            font-weight: 700;
            line-height: 1.4;
        }

        .flow-chain .arr {
            color: var(--amber-soft);
            font-size: 15px;
        }

        /* approach grid */
        .serv-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
        }

        .serv-card {
            background: linear-gradient(160deg, var(--bg-3), var(--bg));
            border: 1px solid var(--line);
            border-radius: 20px;
            padding: 36px;
            position: relative;
            overflow: hidden;
            transition: all .35s cubic-bezier(.16, .8, .24, 1);
        }

        .serv-card:hover {
            border-color: rgba(217, 119, 46, 0.3);
            transform: translateY(-4px);
        }

        .serv-num {
            font-family: 'Space Mono';
            font-size: 12px;
            color: var(--ink-dimmer);
            margin-bottom: 22px;
            display: block;
        }

        .serv-card h4 {
            font-size: 17px;
            margin-bottom: 12px;
            font-weight: 700;
            line-height: 1.4;
        }

        .serv-card p {
            font-size: 13px;
            color: var(--ink-dim);
            line-height: 1.7;
        }

        /* options grid */
        .opt-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .opt-card {
            background: var(--bg-2);
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 30px 24px;
            transition: border-color .3s, transform .3s;
        }

        .opt-card:hover {
            border-color: rgba(217, 119, 46, 0.3);
            transform: translateY(-4px);
        }

        .opt-card h5 {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 12px;
            line-height: 1.4;
        }

        .opt-card p {
            font-size: 12.5px;
            color: var(--ink-dim);
            line-height: 1.65;
        }

        @media (max-width:980px) {
            .opt-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        /* stats band */
        .stats-band {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1px;
            background: var(--line);
            border: 1px solid var(--line);
            border-radius: 20px;
            overflow: hidden;
        }

        .stat-cell {
            background: var(--bg-2);
            padding: 40px 26px;
            text-align: center;
        }

        .stat-cell b {
            font-family: 'Sora';
            font-size: 32px;
            font-weight: 800;
            background: linear-gradient(120deg, var(--amber), var(--amber-soft));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            display: block;
            margin-bottom: 8px;
        }

        .stat-cell span {
            font-size: 11.5px;
            color: var(--ink-dim);
            font-family: 'Space Mono';
            letter-spacing: .03em;
        }

        @media (max-width:980px) {
            .stats-band {
                grid-template-columns: 1fr 1fr;
            }
        }

        /* faq */
        .faq-list {
            max-width: 820px;
            margin: 0 auto;
        }

        .faq-item {
            border: 1px solid var(--line);
            border-radius: 14px;
            background: var(--bg-2);
            margin-bottom: 14px;
            overflow: hidden;
            transition: border-color .25s;
        }

        .faq-item.open {
            border-color: rgba(217, 119, 46, 0.3);
        }

        .faq-q {
            width: 100%;
            text-align: left;
            background: transparent;
            border: none;
            cursor: pointer;
            padding: 24px 26px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 18px;
            color: var(--ink);
            font-family: 'Sora';
            font-size: 14.5px;
            font-weight: 700;
            line-height: 1.5;
        }

